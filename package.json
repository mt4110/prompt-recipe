{
  "name": "prompt-recipe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check": "tsc --noEmit",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "preview:core": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --bin recipe-preview",
    "test:discovery": "node --experimental-strip-types --test scripts/discovery.test.ts",
    "check:boundary": "node scripts/check-local-boundary.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^26",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
